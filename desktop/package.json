{
  "name": "saydaliti-desktop",
  "productName": "Tablix Pharma",
  "version": "1.0.0",
  "description": "Tablix Pharma — برنامج الكمبيوتر: أونلاين بحسابك أو من غير نت على الجهاز",
  "author": "abdelrahman mansour",
  "private": true,
  "main": "main.js",
  "scripts": {
    "app": "node scripts/copy-app.mjs",
    "start": "npm run app && electron .",
    "dist": "npm run app && electron-builder --win nsis --x64 --publish never",
    "smoke": "node smoke.mjs"
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "26.18.0",
    "playwright": "1.63.0",
    "xlsx": "file:../vendor/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.saydaliti.desktop",
    "productName": "Tablix Pharma",
    "artifactName": "TablixPharma-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "genius-live.js",
      "genius-live.ps1",
      "app/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Tablix Pharma",
      "uninstallDisplayName": "Tablix Pharma",
      "deleteAppDataOnUninstall": false
    }
  }
}
